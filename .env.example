# 不配置飞书时，仅启动 127.0.0.1 本地演示，使用独立的演示数据文件。
PORT=4173
# 以下四项同时配置才会开启飞书身份验证。请勿把密钥提交到代码仓库。
# FEISHU_APP_ID=cli_xxxxxxxxxx
# FEISHU_APP_SECRET=
# BASE_URL=https://attendance.example.com
# ADMIN_OPEN_IDS=ou_xxxxxxxxxx,ou_yyyyyyyyyy
# 可选：限制登录租户
# FEISHU_TENANT_KEY=
# 正式环境如需由反向代理或容器访问，显式设置监听地址。
# HOST=0.0.0.0

# 高德 Web 端（JS API）：两项需一起配置；安全密钥仅保存在服务器。
# AMAP_JS_KEY=
# AMAP_SECURITY_JS_CODE=
