# 不配置飞书时，仅启动 127.0.0.1 本地演示，使用独立的演示数据文件。
PORT=4173
# 以下四项同时配置才会开启飞书身份验证。请勿把密钥提交到代码仓库。
# FEISHU_APP_ID=cli_xxxxxxxxxx
# FEISHU_APP_SECRET=
# BASE_URL=https://attendance.example.com
# ADMIN_OPEN_IDS=ou_xxxxxxxxxx,ou_yyyyyyyyyy
# 可选：限制登录租户
# FEISHU_TENANT_KEY=
# 原生工作台小组件：精确填写本组织飞书域名，仍需本自建应用验证身份并绑定员工。
# FEISHU_WIDGET_ORIGIN=https://your-company.feishu.cn
# 正式环境如需由反向代理或容器访问，显式设置监听地址。
# HOST=0.0.0.0

# 高德 Web 端（JS API）：两项需一起配置；安全密钥仅保存在服务器。
# AMAP_JS_KEY=
# AMAP_SECURITY_JS_CODE=

# 开启应用机器人并获批 im:message:send_as_bot 后启用排班提醒。
# REMINDERS_ENABLED=false

# 原生审批、日历、组织事件与多维表格：完成授权及资源配置后一起启用。
# FEISHU_WORKFLOWS_ENABLED=false
# FEISHU_LEAVE_APPROVAL_CODE=
# FEISHU_LEAVE_APPROVAL_ID=
# FEISHU_OVERTIME_APPROVAL_CODE=
# FEISHU_OVERTIME_APPROVAL_ID=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=
