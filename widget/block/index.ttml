<view class="attendance">
  <view class="state" tt:if="{{error}}">
    <text class="error">{{error}}</text>
    <view class="action retry" bindtap="refresh"><text class="action-label">重新加载</text></view>
  </view>
  <view class="state" tt:elif="{{loading}}"><text class="muted">正在读取你的今日安排…</text></view>
  <view class="content" tt:else>
    <view class="progress">
      <view class="count">
        <text class="number">{{remaining}}</text>
        <view class="count-detail"><text class="count-label">次待打卡</text><text class="completed">已完成 {{completed}} / {{total}} 次</text></view>
      </view>
      <view class="action {{canPunch ? '' : 'secondary'}}" bindtap="openAttendance"><text class="action-label {{canPunch ? '' : 'secondary-label'}}">{{canPunch ? '去打卡' : '我的记录'}}</text></view>
    </view>
    <text class="next-place">{{next}}</text>
    <text class="places">{{places}}</text>
  </view>
</view>
