.attendance { display: flex; flex-direction: column; width: 100%; height: 150px; padding: 12px; box-sizing: border-box; background-color: #ffffff; }
.heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; width: 100%; height: 18px; flex-shrink: 0; }
.title { font-size: 14px; line-height: 18px; font-weight: 600; color: #1f2329; }
.refresh { padding: 4px 8px; flex-shrink: 0; }
/* Native Block does not inherit text styles or expand flex shorthand like the web. */
.refresh-label { color: #245bdb; font-size: 12px; line-height: 18px; white-space: nowrap; }
.content { display: flex; flex-direction: column; width: 100%; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-height: 0; }
.progress { display: flex; flex-direction: row; align-items: center; width: 100%; height: 50px; flex-shrink: 0; }
.count { display: flex; flex-direction: row; align-items: baseline; width: 108px; flex-shrink: 0; }
.number { font-size: 30px; line-height: 36px; font-weight: 600; color: #245bdb; }
.count-label { font-size: 12px; line-height: 18px; margin-left: 6px; color: #646a73; }
.next { display: flex; flex-direction: column; width: 0px; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-width: 0; }
.completed { width: 100%; font-size: 11px; line-height: 14px; color: #646a73; margin-bottom: 4px; white-space: nowrap; }
.next-place { width: 100%; font-size: 13px; line-height: 18px; font-weight: 500; color: #1f2329; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.places { width: 100%; font-size: 12px; color: #646a73; height: 24px; line-height: 20px; flex-shrink: 0; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.action { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 100%; height: 32px; flex-shrink: 0; border-radius: 6px; background-color: #245bdb; }
.action-label { font-size: 14px; line-height: 20px; color: #ffffff; white-space: nowrap; }
.secondary { background-color: #f0f4ff; }
.secondary-label { color: #245bdb; }
.state { display: flex; flex-direction: column; justify-content: space-around; width: 100%; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-height: 0; }
.error { width: 100%; font-size: 13px; color: #646a73; line-height: 20px; }
.muted { width: 100%; font-size: 13px; color: #646a73; line-height: 20px; }
